# ================= Stage 1: 前端资源编译打包 =================
FROM node:18-alpine AS builder

# 替换 Alpine apk 镜像源为国内清华源
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apk/repositories

WORKDIR /app

# 复制依赖配置文件，并使用淘宝 NPM 镜像源加速依赖拉取
COPY ./pipelinex_web/package.json ./
RUN npm config set registry https://registry.npmmirror.com && npm install

# 复制前端源码并进行生产环境构建
COPY ./pipelinex_web/ ./
RUN npm run build

# ================= Stage 2: Nginx 静态文件服务器与反代 =================
FROM nginx:alpine

# 替换 Alpine apk 镜像源为国内清华源
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apk/repositories

# 将 Stage 1 编译产出的 build 目录复制到 Nginx 默认静态资源路径
COPY --from=builder /app/build /usr/share/nginx/html

# 覆盖 Nginx 默认代理规则以支持 React 路由和后端反代
COPY ./example/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
