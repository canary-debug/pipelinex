FROM python:3.12-slim

# 1. 替换 Debian apt 系统源为国内清华镜像源，并安装系统与 mysqlclient 编译依赖
RUN sed -i 's/deb.debian.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's/deb.debian.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apt/sources.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    git \
    openssh-client \
    curl \
    pkg-config \
    default-libmysqlclient-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 2. 设置容器工作目录与全局镜像源环境变量
WORKDIR /root/pipelinex/pipelinex_api
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 3. 使用国内 PyPI 镜像源加速安装 Python 依赖（显式降级 setuptools 以保证 pkg_resources 兼容）
COPY ./pipelinex_api/requirements.txt ./
RUN pip install --no-cache-dir "setuptools<70.0.0" -i https://pypi.tuna.tsinghua.edu.cn/simple \
    && pip install --no-cache-dir -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple

# 4. 复制后端全部代码文件
COPY ./pipelinex_api/ ./

# 5. 挂载并转换多进程启动脚本 (防 Windows 换行符 CRLF 兼容报错)
COPY ./example/entrypoint.sh /root/entrypoint.sh
RUN sed -i 's/\r$//' /root/entrypoint.sh && chmod +x /root/entrypoint.sh

# 6. 暴露 8000 后端端口与定义入口
EXPOSE 8000
ENTRYPOINT ["/root/entrypoint.sh"]
